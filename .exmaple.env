# xAI Grok — narrative generation
# Get your API key at https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# Comfy Cloud — image generation
# Get your API key at https://platform.comfy.org/login (Creator or Pro tier required)
COMFY_CLOUD_API_KEY=your_comfy_cloud_api_key_here

# Path to your workflow JSON (exported from ComfyUI via "Save (API Format)")
# Default: ./workflows/zombie-scene.json
# COMFY_WORKFLOW_PATH=./workflows/zombie-scene.json

# ID of the node in the workflow whose input should receive the generated prompt
# (typically the positive CLIPTextEncode node — open your workflow JSON to find it)
COMFY_PROMPT_NODE_ID=6

# Key of the input on that node where the prompt text goes (usually "text")
# COMFY_PROMPT_INPUT_KEY=text
